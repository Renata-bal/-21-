color1 = input("Введите первый основной цвет (красный, жёлтый или синий): ")
color2 = input("Введите второй основной цвет (синий, красный, жёлтый): ")

if color1 == "красный" and color2 == "синий":
    print("Получается фиолетовый")
elif color1 == "жёлтый" and color2 == "красный":
    print("Получается оранжевый")
elif color1 == "синий" and color2 == "жёлтый":
    print("Получается зелёный")
else:
    print("Ошибка")
