def convert_usd_to_rub(amount_usd):
    """
    Конвертирует сумму из долларов в рубли по текущему курсу.

    Args:
        amount_usd (float): Сумма в долларах, которую нужно конвертировать.

    Returns:
        float: Эквивалентная сумма в рублях.
    """
    USD_TO_RUB = 83.00  
    return amount_usd * USD_TO_RUB

amount_usd = float(input("Введите сумму в долларах для перевода в рубли: "))
amount_usd = convert_usd_to_rub(amount_usd)

print(f"Ваша сумма в рублях составляет: {amount_usd}")
