#Вводятся координаты первой и второй клеток
x1, y1, x2, y2 = map(int, input("Введите координаты первой и второй клеток (стобец, строка) через запятую (от 1 до 8): ").split(","))

#Программа высчитывает сумму координат для первой клетки
sum1 = x1 + y1

#Программа высчитывает сумму координат для второй клетки
sum2 = x2 + y2

#Проверяет, одинакова ли чётность сумм координат
if sum1 % 2 == sum2 % 2:
    #Если чётность совпадает — клетки одного цвета
    print("YES")
else:
    #Иначе — клетки разного цвета
    print("NO")
