#Вводятся координаты первой и второй клеток
x1, y1, x2, y2 = map(int, input("Введите координаты первой и второй клеток (стобец, строка) через запятую (от 1 до 8): ").split(","))

#Слон ходит по диагоналям: если расстояния по осям равны — клетки на одной диагонали, ход возможен
if abs(x1 - x2) == abs(y1 - y2):
    print("YES")

#Если смещения разные, слон туда за один ход не попадёт
else:
    print("NO")
