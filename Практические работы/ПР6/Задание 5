#Вводятся координаты первой и второй клеток
x1, y1, x2, y2 = map(int, input("Введите координаты первой и второй клеток (стобец, строка) через запятую (от 1 до 8): ").split(","))

# Ферзь ходит:
# 1) по вертикали — тогда столбцы совпадают abs(x1 - x2)
# 2) по горизонтали — тогда строки совпадают abs(y1 - y2)
# 3) по диагонали — тогда модуль разности столбцов равен модулю разности строк

#Программа проверяет, выполняется ли хотя бы одно из трёх условий хода ферзя
if abs(x1 - x2) or abs(y1 - y2):
    print("YES")

#Если ни одно условие не выполнилось — такого хода нет
else:
    print("NO")
