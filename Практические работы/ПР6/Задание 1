temperature = float(input("Введите температуру (°C): "))
pressure = float(input("Введите верхнее давление: "))
pulse = float(input("Введите пульс: "))

if (36 <= temperature <= 37) and (110 <= pressure <= 130) and (60 <= pulse <= 100):
    print ("Нормальное состояние")
elif (35 <= temperature <= 36) or (37 <= temperature <= 38) or (105 <= pressure <= 110) or (130 <= pressure <= 140) or  (55 <= pulse <= 60) or (100 <= pulse <= 110):
    print("Легкое недомогание")
else:
    print ("Требуется врач")
